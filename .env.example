# Optional. If omitted, RAGBench runs in local mock mode.
OPENAI_API_KEY=
# Optional: only for `anthropic:` model refs (also needs `pip install 'ragbench[anthropic]'`).
ANTHROPIC_API_KEY=
# Optional: only for `openrouter:` model refs (open-weight and other models through OpenRouter; see docs/models.md).
OPENROUTER_API_KEY=
# Optional: any variable named by `api_key_env:` under a `providers:` endpoint in your config, e.g.
